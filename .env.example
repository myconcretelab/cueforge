# PostgreSQL Alwaysdata: postgresql-<compte>.alwaysdata.net:5433 via pgBouncer
DATABASE_URL=postgresql://cueforge:password@localhost:5432/cueforge
SESSION_SECRET=replace-with-at-least-32-random-characters
STORAGE_PATH=./storage
HOST=127.0.0.1
PORT=8100
PUBLIC_URL=http://localhost:5173
FREESOUND_API_KEY=
SUPER_ADMIN_EMAILS=admin@example.com
MAIL_FROM=CueForge <noreply@cueforge.fr>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SENDMAIL_PATH=/usr/sbin/sendmail
NODE_ENV=development
