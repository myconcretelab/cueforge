{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CueForge Bridge",
  "version": "0.1.0",
  "identifier": "fr.cueforge.bridge",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "CueForge Bridge",
        "width": 560,
        "height": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:43821; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["cueforge-bridge"]
      }
    }
  }
}
